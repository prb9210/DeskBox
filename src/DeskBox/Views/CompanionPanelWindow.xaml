<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.CompanionPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="桌面管家">

    <Grid
        x:Name="RootGrid"
        Padding="24,20,24,18"
        RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                Text="桌面管家" />
            <TextBlock
                x:Name="SubtitleText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="桌面文件自动分类 · 库与坚果云客户端同步" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="当前动作" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActionText" Text="-" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="最近扫描" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScanText" Text="-" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="最近整理" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ApplyText" Text="-" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="最近同步" />
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SyncText" Text="-" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource CaptionTextBlockStyle}" Text="最近错误" />
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ErrorText" Text="-" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="库位置" />
                        <TextBlock x:Name="LibraryText" Text="-" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="待删除（可捞回）" Margin="0,6,0,0" />
                        <TextBlock x:Name="TrashText" Text="-" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>

                <Border
                    Padding="14"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="同步周期" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="IntervalBox" MinWidth="150" SelectionChanged="IntervalBox_SelectionChanged" />
                            <Button x:Name="SaveIntervalButton" Content="保存周期" Click="SaveIntervalButton_Click" />
                        </StackPanel>
                        <TextBlock
                            x:Name="IntervalHintText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            Text="坚果云对 WebDAV 请求频率敏感，限流时把周期调长（60/120 分钟）；交给坚果云客户端同步时这一项不起作用。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="MessageText" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="ApplyButton" Content="立即整理" Click="ApplyButton_Click" />
                <Button x:Name="SyncButton" Content="立即同步（WebDAV）" Click="SyncButton_Click" />
                <Button x:Name="BackupButton" Content="立即备份" Click="BackupButton_Click" />
                <Button x:Name="OpenDashboardButton" Content="完整看板" Click="OpenDashboardButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
