<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.CompanionSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Label column of every settings row: one width for the whole page so
                 the controls line up vertically instead of wherever the text ends. -->
            <x:Double x:Key="CompanionLabelWidth">96</x:Double>
            <CornerRadius x:Key="CompanionCardCorner">6</CornerRadius>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Style="{StaticResource SectionPanelStyle}"
        MinWidth="520"
        Spacing="4">

        <!-- ============================ 运行状态 ============================ -->
        <toolkit:SettingsCard
            Description="引擎每 20 秒扫一次桌面，这里每 5 秒自动刷新"
            Header="运行状态"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE9D9;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="16" RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="当前动作" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActionValue" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近扫描" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScanValue" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近整理" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ApplyValue" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近同步" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SyncValue" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近错误" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ErrorValue" Text="-" TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource SettingDescriptionTextStyle}" Text="AI 分类" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="AiValue" Text="-" TextWrapping="Wrap" />
            </Grid>
        </toolkit:SettingsCard>

        <!-- ============================ 立即操作 ============================ -->
        <toolkit:SettingsCard
            Description="整理与同步互斥：同步进行中整理会排队，绝不并发搬同一批文件"
            Header="立即操作"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE768;" />
            </toolkit:SettingsCard.HeaderIcon>
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="ApplyNowButton" Click="ApplyNowButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="立即整理" />
                    <Button x:Name="SyncNowButton" Click="SyncNowButton_Click" Content="立即同步" />
                    <Button x:Name="BackupNowButton" Click="BackupNowButton_Click" Content="立即备份" />
                </StackPanel>
                <TextBlock x:Name="ActionMessage" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" TextAlignment="Right" />
            </StackPanel>
        </toolkit:SettingsCard>

        <!-- ============================ 路径 ============================ -->
        <toolkit:SettingsCard
            Description="桌面是管家盯的目录；共享库是分类后的家。两者都不要放在 DeskBox 的托管存储里"
            Header="文件夹"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8B7;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="桌面文件夹" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DesktopBox" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="共享库文件夹" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="LibraryBox" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TrashText" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" Text="待删除目录：-" />
            </Grid>
        </toolkit:SettingsCard>

        <!-- ============================ 同步 ============================ -->
        <toolkit:SettingsCard
            Description="走坚果云客户端同步时，请关掉这里的 WebDAV 同步，避免两条路互相干扰"
            Header="同步与备份"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE895;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="同步间隔" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="IntervalBox" HorizontalAlignment="Stretch" SelectionChanged="IntervalBox_SelectionChanged" />

                <CheckBox Grid.Row="1" Grid.Column="1" x:Name="SyncEnabledCheck" Content="启用管家自带 WebDAV 同步" />
            </Grid>
        </toolkit:SettingsCard>

        <!-- ============================ 账号 ============================ -->
        <toolkit:SettingsCard
            Description="应用密码在坚果云网页「账户信息 → 安全选项 → 添加应用」生成；留空表示不修改"
            Header="坚果云与 AI"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8D7;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="坚果云账号" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="UserBox" HorizontalAlignment="Stretch" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="应用密码" />
                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBoxControl" HorizontalAlignment="Stretch" PlaceholderText="留空则不修改" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="DeepSeek 密钥" />
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="ApiKeyBox" HorizontalAlignment="Stretch" PlaceholderText="留空则不修改" />
            </Grid>
        </toolkit:SettingsCard>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,10">
            <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="保存设置" />
            <TextBlock x:Name="SaveMessage" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============================ 重新归类 ============================ -->
        <toolkit:SettingsCard
            Description="已经归档的文件或文件夹也能改地方：选源、选目标分类，一键移动，并把这次判断记成规则"
            Header="重新归类"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8AB;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="源文件/文件夹" />
                <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SourcePathBox" PlaceholderText="在资源管理器里右键 →「复制文件地址」，粘到这里" />
                    <Button Grid.Column="1" Click="PickFileButton_Click" Content="选文件…" />
                    <Button Grid.Column="2" Click="PickFolderButton_Click" Content="选文件夹…" />
                </Grid>

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="目标分类" />
                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetCategoryBox" HorizontalAlignment="Stretch" />

                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="MoveSourceButton" Click="MoveSourceButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="移动过去" />
                    <TextBlock x:Name="MoveMessage" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </toolkit:SettingsCard>

        <!-- ======================= 列表区（一套卡片壳） ======================= -->
        <toolkit:SettingsCard
            Description="只预览不会移动；确认无误再点上面的「立即整理」"
            Header="待整理计划"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8FD;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button Click="RefreshPlanButton_Click" Content="刷新" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="PlanList" Spacing="6" Margin="16,6,16,14" />

        <toolkit:SettingsCard
            Description="同一文件两端都改过；每组留一份，其余归集到 _冲突"
            Header="同步冲突"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE7BA;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button Click="ArchiveConflictsButton_Click" Content="归集冲突副本" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="ConflictList" Spacing="6" Margin="16,6,16,14" />

        <toolkit:SettingsCard
            Description="管家拿不准的文件和文件夹都在这里：每行选一个分类点「移动到这里」；建议只是默认值"
            Header="待归类治理"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8F1;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button Click="RefreshPendingButton_Click" Content="刷新" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="PendingList" Spacing="6" Margin="16,6,16,14" />

        <toolkit:SettingsCard
            Description="按大小与内容比对；「多余的移到 _重复」只移动、不删除"
            Header="重复文件"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE8C8;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button Click="RefreshDuplicatesButton_Click" Content="重新扫描" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="DuplicateList" Spacing="6" Margin="16,6,16,14" />

        <toolkit:SettingsCard
            Description="同一主题攒够文件后，管家会建议新建一个分类目录"
            Header="新分类建议"
            HorizontalContentAlignment="Stretch">
            <toolkit:SettingsCard.HeaderIcon>
                <FontIcon Glyph="&#xE710;" />
            </toolkit:SettingsCard.HeaderIcon>
            <Button Click="RefreshProposalsButton_Click" Content="刷新" />
        </toolkit:SettingsCard>
        <StackPanel x:Name="ProposalList" Spacing="6" Margin="16,6,16,14" />
    </StackPanel>
</UserControl>
