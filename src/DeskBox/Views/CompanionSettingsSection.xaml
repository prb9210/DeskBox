<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.CompanionSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 本页统一用「竖排卡片」：标题一行、说明一行（自动换行）、下面才是控件。
         SettingsCard 的 Header/Description 放在右侧内容很宽的卡片里会被挤成一列
         单字（标题列被内容列吃光宽度），所以这里不用 SettingsCard，改用 Border
         + 两栏/一栏自适应布局，保证中文说明永远横排。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Label column of every settings row: one width for the whole page so
                 the controls line up vertically instead of wherever the text ends. -->
            <x:Double x:Key="CompanionLabelWidth">96</x:Double>
            <CornerRadius x:Key="CompanionCardCorner">6</CornerRadius>

            <!-- 卡片标题行：图标 + 标题，右侧可以放按钮 -->
            <Style x:Key="CompanionCardIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel
        Style="{StaticResource SectionPanelStyle}"
        MinWidth="520"
        Spacing="4">

        <!-- ============================ 运行状态 ============================ -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE9D9;" Style="{StaticResource CompanionCardIconStyle}" />
                    <TextBlock Text="运行状态" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                           Text="引擎每 20 秒扫一次桌面，这里每 5 秒自动刷新" />

                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="当前动作" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ActionValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近扫描" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ScanValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近整理" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="ApplyValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="最近错误" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ErrorValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="AI 分类" />
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="AiValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 更新入口统一放在「关于 → 升级通道」，这里只留一个隐藏占位，
             等自动更新接好后再彻底删除（避免两个地方各有一套更新按钮）。 -->
        <Border Visibility="Collapsed" Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE895;" Style="{StaticResource CompanionCardIconStyle}" />
                    <TextBlock Text="程序更新" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="更新已统一到「关于 → 升级通道」" />

                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="当前版本" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="UpdateVersionValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="更新状态" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="UpdateStateValue" Style="{StaticResource SettingValueTextStyle}" Text="-" TextWrapping="Wrap" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <Button x:Name="UpdateNowButton" Click="UpdateNow_Click" Content="立即检查并更新" />
                        <CheckBox x:Name="AutoUpdateCheckBox" Checked="AutoUpdateCheckBox_Checked" Content="开机自动检查（每 2 小时）" Unchecked="AutoUpdateCheckBox_Unchecked" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================ 立即操作 ============================ -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="立即操作" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="ApplyNowButton" Click="ApplyNowButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="立即整理" />
                        <Button x:Name="BackupNowButton" Click="BackupNowButton_Click" Content="立即备份" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                           Text="整理与同步互斥：同步进行中整理会排队，绝不并发搬同一批文件" />
                <TextBlock x:Name="ActionMessage" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- ============================ 路径 ============================ -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8B7;" Style="{StaticResource CompanionCardIconStyle}" />
                    <TextBlock Text="文件夹" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                           Text="桌面是管家盯的目录；共享库是分类后的家。两者都不要放在 DeskBox 的托管存储里" />

                <Grid ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="桌面文件夹" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="DesktopBox" HorizontalAlignment="Stretch" />
                    <Button Grid.Row="0" Grid.Column="2" Click="PickDesktopFolder_Click" Content="浏览…" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="共享库文件夹" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="LibraryBox" HorizontalAlignment="Stretch" />
                    <Button Grid.Row="1" Grid.Column="2" Click="PickLibraryFolder_Click" Content="浏览…" />

                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap"
                               Text="共享库建议放在坚果云同步的文件夹里（例如 …\我的坚果云\教学资料库）。选完记得点下面的「保存设置」。" />

                    <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" x:Name="TrashText" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" Text="待删除目录：-" />

                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="GenerateWidgetsButton" Click="GenerateCategoryWidgets_Click" Content="按分类生成格子" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource SettingDescriptionTextStyle}"
                                       Text="把库里的 01…08 八个类别各建一个格子，悬浮球展开时就能看到它们。" />
                        </StackPanel>
                        <TextBlock x:Name="GenerateWidgetsMessage" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============================ 账号 ============================ -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8D7;" Style="{StaticResource CompanionCardIconStyle}" />
                    <TextBlock Text="AI 分类" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                           Text="填入 DeepSeek 密钥后，规则拿不准的文件交给 AI 定夺；留空表示不修改。文件同步由坚果云客户端负责，这里不再配置。" />

                <Grid ColumnSpacing="16" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="DeepSeek 密钥" />
                    <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="ApiKeyBox" HorizontalAlignment="Stretch" PlaceholderText="留空则不修改" />
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,10">
            <Button x:Name="SaveButton" Click="SaveButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="保存设置" />
            <TextBlock x:Name="SaveMessage" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ============================ 重新归类 ============================ -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xE8AB;" Style="{StaticResource CompanionCardIconStyle}" />
                    <TextBlock Text="重新归类" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}"
                           Text="已经归档的文件或文件夹也能改地方：选源、选目标分类，一键移动，并把这次判断记成规则" />

                <Grid ColumnSpacing="8" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="{StaticResource CompanionLabelWidth}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="源文件/文件夹" />
                    <Grid Grid.Row="0" Grid.Column="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SourcePathBox" PlaceholderText="右键「复制文件地址」后粘到这里" />
                        <Button Grid.Column="1" Click="PickFileButton_Click" Content="选文件…" />
                        <Button Grid.Column="2" Click="PickFolderButton_Click" Content="选文件夹…" />
                    </Grid>

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" Text="目标分类" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="TargetCategoryBox" HorizontalAlignment="Stretch" />

                    <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="MoveSourceButton" Click="MoveSourceButton_Click" Style="{StaticResource AccentActionButtonStyle}" Content="移动过去" />
                        <TextBlock x:Name="MoveMessage" VerticalAlignment="Center" Style="{StaticResource SettingDescriptionTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ======================= 列表区（一套卡片壳） ======================= -->
        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8FD;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="待整理计划" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshPlanButton_Click" Content="刷新" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="只预览不会移动；确认无误再点上面的「立即整理」" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="PlanList" Spacing="6" Margin="16,6,16,14" />

        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="同步冲突" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="ArchiveConflictsButton_Click" Content="归集冲突副本" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="同一文件两端都改过；每组留一份，其余归集到 _冲突" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="ConflictList" Spacing="6" Margin="16,6,16,14" />

        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8F1;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="待归类治理" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshPendingButton_Click" Content="刷新" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="管家拿不准的文件和文件夹都在这里：每行选一个分类点「移动到这里」；建议只是默认值" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="PendingList" Spacing="6" Margin="16,6,16,14" />

        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8C8;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="重复文件" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshDuplicatesButton_Click" Content="重新扫描" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="按大小与内容比对；「多余的移到 _重复」只移动、不删除" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="DuplicateList" Spacing="6" Margin="16,6,16,14" />

        <Border Style="{StaticResource SettingsGroupStyle}" Padding="16,12">
            <StackPanel Spacing="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" Style="{StaticResource CompanionCardIconStyle}" />
                        <TextBlock Text="新分类建议" Style="{StaticResource SettingTitleTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button Grid.Column="1" Click="RefreshProposalsButton_Click" Content="刷新" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource SettingDescriptionTextStyle}" Text="同一主题攒够文件后，管家会建议新建一个分类目录" />
            </StackPanel>
        </Border>
        <StackPanel x:Name="ProposalList" Spacing="6" Margin="16,6,16,14" />
    </StackPanel>
</UserControl>
