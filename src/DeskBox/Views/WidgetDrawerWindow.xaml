<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.WidgetDrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        DoubleTapped="RootGrid_DoubleTapped"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        RightTapped="RootGrid_RightTapped">

        <Border
            x:Name="Ball"
            Width="56"
            Height="56"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            BorderThickness="1"
            CornerRadius="28"
            Opacity="0.45"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="BallScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
                <TextBlock
                    x:Name="BallGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="格" />
                <Border
                    x:Name="StateDot"
                    Width="10"
                    Height="10"
                    Margin="0,0,7,7"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="White"
                    CornerRadius="5"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
