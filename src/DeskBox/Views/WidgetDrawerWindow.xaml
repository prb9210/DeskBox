<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.WidgetDrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- No fixed sizes anywhere: the ball is placed from the window's real
         client size in code, so DPI scaling cannot push it off the frame. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        DoubleTapped="RootGrid_DoubleTapped"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        RightTapped="RootGrid_RightTapped">

        <Canvas x:Name="FanCanvas" />

        <Canvas x:Name="BallLayer">
            <!-- Outer glow ring -->
            <Border
                x:Name="BallRing"
                Width="64"
                Height="64"
                CornerRadius="32"
                BorderThickness="1"
                Background="{x:Null}"
                IsHitTestVisible="False" />

            <!-- The bead -->
            <Border
                x:Name="Ball"
                Width="56"
                Height="56"
                CornerRadius="28"
                BorderThickness="1.2">
                <Grid>
                    <TextBlock
                        x:Name="BallGlyph"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsHitTestVisible="False"
                        Text="格" />
                    <Border
                        x:Name="StateDot"
                        Width="9"
                        Height="9"
                        Margin="0,0,4,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="White"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4.5"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
