<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.WidgetDrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The window is the ball: 68 DIP, clipped to a circle by an elliptic window
        region. Content must bleed to the edges, otherwise the window's own black
        background shows through the clip (that was the "black octagon").
    -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        DoubleTapped="RootGrid_DoubleTapped"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        RightTapped="RootGrid_RightTapped">

        <Border
            x:Name="Ball"
            BorderThickness="1.5"
            CornerRadius="34"
            Opacity="0.5">
            <Grid>
                <TextBlock
                    x:Name="BallGlyph"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="格" />
                <Border
                    x:Name="StateDot"
                    Width="9"
                    Height="9"
                    Margin="0,0,9,9"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="White"
                    CornerRadius="4.5"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</Window>
