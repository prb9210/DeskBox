<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DeskBox.Views.WidgetDrawerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Nothing is positioned by XAML alignment: the code places the ball at
         the centre of the real client area, so DPI scaling cannot shift it. -->
    <Grid
        x:Name="RootGrid"
        Background="Transparent"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerEntered="RootGrid_PointerEntered"
        PointerExited="RootGrid_PointerExited"
        PointerMoved="RootGrid_PointerMoved"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        RightTapped="RootGrid_RightTapped">

        <Canvas x:Name="FanCanvas" />

        <Canvas x:Name="BallLayer">
            <!-- A ring plus an ellipse: a corner radius on a Border gets
                 mis-proportioned under DPI scaling and renders as a square
                 with clipped corners, an ellipse is always a circle. -->
            <Ellipse
                x:Name="BallRing"
                Width="60"
                Height="60"
                IsHitTestVisible="False"
                Stroke="#66FFFFFF"
                StrokeThickness="1" />

            <!-- Default fill lives in XAML: if the colour code path ever fails to
                 run, the ball must still be an opaque circle rather than an
                 invisible ring on top of the window backdrop. -->
            <Ellipse x:Name="Ball" Width="56" Height="56" IsHitTestVisible="False">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.25,0.05" EndPoint="0.75,0.95">
                        <GradientStop Offset="0" Color="#FF3A3F45" />
                        <GradientStop Offset="1" Color="#FF20242A" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 玻璃高光：球顶部一层白到透明的渐变，强度由玻璃主题控制。 -->
            <Ellipse
                x:Name="BallHighlight"
                Width="56"
                Height="56"
                IsHitTestVisible="False"
                Opacity="0.12">
                <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0.18,0.02" EndPoint="0.62,0.92">
                        <GradientStop Offset="0" Color="#D9FFFFFF" />
                        <GradientStop Offset="0.42" Color="#33FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <TextBlock
                x:Name="BallGlyph"
                FontFamily="Microsoft YaHei UI"
                FontSize="17"
                FontWeight="SemiBold"
                Foreground="White"
                IsHitTestVisible="False"
                Text="格" />

            <Ellipse
                x:Name="StateDot"
                Width="9"
                Height="9"
                Fill="White"
                Stroke="#33000000"
                StrokeThickness="1"
                Visibility="Collapsed" />

            <!-- 待归类 / 暂存 / 备忘角标。放在球内右上角，避免被窗口裁圆切掉。 -->
            <Border
                x:Name="Badge"
                Width="19"
                Height="19"
                CornerRadius="9.5"
                Background="#E5484D"
                BorderBrush="#CCFFFFFF"
                BorderThickness="1"
                Visibility="Collapsed"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="BadgeText"
                    FontFamily="Microsoft YaHei UI"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="0" />
            </Border>
        </Canvas>
    </Grid>
</Window>
